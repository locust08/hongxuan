{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hongxuan-astro",
  "account_id": "e7c515dde995479daacd82ad79dfc3e8",
  "workers_dev": true,
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/app/data/*"]
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "hongxuan",
    "database_id": "7ae9f20a-f943-4747-9c57-dcc8b284ed1d",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "hongxuan-uploads" }],
  "kv_namespaces": [{ "binding": "SESSION", "id": "2dfa2ced46534455ae81c0746a8b3053" }],
  "vars": {
    "MAIL_API_URL": "",
    "MAIL_FROM": "",
    "MAIL_TO": "",
    "MAIL_MODE": "outbox"
  },
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] }
}
