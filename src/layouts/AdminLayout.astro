---
import type {PageResult,RequestContext} from '../server/contracts';
import {all,first} from '../server/core';
const {page,ctx}=Astro.props as {page:PageResult,ctx:RequestContext};
const heading=await first(ctx,'SELECT * FROM heading WHERE id=1');
const logged=ctx.session.userId!==null;
const login=/\/login(?:_action)?\.asp$/i.test(ctx.path);
const modules=logged?await all(ctx,'SELECT m.* FROM module m JOIN groupmoduleaccess g ON g.moduleid=m.moduleid WHERE g.groupid=? ORDER BY moduleorder',[ctx.session.groupId]):[];
const subs=logged?await all(ctx,'SELECT s.* FROM submodule s JOIN groupsubmoduleaccess g ON g.smid=s.smid WHERE g.groupid=? AND s.groupto=0 ORDER BY smorder',[ctx.session.groupId]):[];
const requested=ctx.url.searchParams.get('moduleid');
if(requested && modules.some(m=>String(m.moduleid)===requested))ctx.cookies.set('hx_admin_module',requested,{path:'/app/',httpOnly:true,sameSite:'lax'});
const selected=requested??ctx.cookies.get('hx_admin_module')?.value??'';
const appPath=(value:unknown)=>String(value??'').startsWith('/app/')?String(value):'/app'+String(value??'');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><link rel="stylesheet" href="/styles/admin-responsive.css"/><meta name="robots" content="noindex,nofollow"/><title>Hong Xuan Terminals and Wire Harness Manufacturer Sdn Bhd.</title><link rel="stylesheet" href="/app/b.css"/><style is:inline>body{margin:0;background:white}[data-rich-editor] button,[data-rich-editor] select{font-family:Arial,sans-serif;font-size:11px}.admin-shell{min-width:760px}a{color:#000080}.admin-menu a{text-decoration:none}.admin-menu td{font-family:Arial,sans-serif}.admin-menu td b{font-size:10pt;font-weight:900}.admin-menu td:not([bgcolor]){font-size:8pt}@media print{.admin-menu{display:none}} </style></head><body class="admin-site" data-login={login?'true':undefined} style={login?'margin:8px':'margin:0'}><table class="admin-shell" border="0" width="100%" cellpadding="1" cellspacing="1"><tr><td colspan="2"><table width="100%" class="show admin-header" cellspacing="0" cellpadding="0"><tr><td {...{width:'250'}} {...{height:'80'}} valign="top"><img src={heading?.hd_logo?'/app/images/'+encodeURIComponent(String(heading.hd_logo)):'/app/images/default1.jpg'} alt=""/></td><td {...{width:'20'}}>&nbsp;</td><td {...{width:'100%'}}><font class="bold" color="#336699" style="font-size:16px"><b>{heading?.hd_title}</b></font><br/><font class="label" {...{size:'2'}}>{heading?.hd_name}</font><br/>{heading?.hd_add1} {heading?.hd_add2} {heading?.hd_add3}<br/>{heading?.hd_tel?'Tel: '+heading.hd_tel:''} {heading?.hd_fax?'Fax: '+heading.hd_fax:''}</td></tr><tr><td colspan="3"><hr {...{size:'1'}}/></td></tr></table></td></tr><tr class="admin-workspace">{logged&&<td class="admin-navigation" {...{width:'120'}} valign="top"><table class="admin-menu" width="120" border="0" bgcolor="#EEEEFF" cellpadding="3" cellspacing="1">{modules.map(m=><Fragment><tr><td {...{bgcolor:'#95CCFF'}}><b><a class="underlining" href={'/app/module/index.asp?moduleid='+m.moduleid}>{m.modulename}</a></b></td></tr>{subs.filter(s=>s.moduleid===m.moduleid && (String(m.moduleid)===selected || Number(m.moduleid)===2)).map(s=><tr><td><a class="underlining" href={appPath(s.smpath)}>{s.smname}</a></td></tr>)}</Fragment>)}</table></td>}<td class="admin-main" {...{width:'100%'}} valign="top"><div class="admin-content" set:html={page.html}/></td></tr>{logged&&<tr><td colspan="2"><hr/><div style="text-align:center" class="smallnote">For technical report, kindly capture the error screen and send to <a href="mailto:technical@locus.com.my">technical@locus.com.my</a> with company details.</div></td></tr>}</table><script is:inline src="/admin-responsive.js" defer></script></body></html>
